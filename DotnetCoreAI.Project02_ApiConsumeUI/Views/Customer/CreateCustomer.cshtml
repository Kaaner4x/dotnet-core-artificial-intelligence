@model DotnetCoreAI.Project02_ApiConsumeUI.Dtos.CreateCustomerDto

@{
    Layout = null;
}

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<form method="post">
    <div class="container">
        <br />
        <label>Customer Name</label>
        <input type="text" asp-for="customerName" class="form-control" />
        <br />

        <label>Customer Surname</label>
        <input type="text" asp-for="customerSurname" class="form-control" />
        <br />

        <label>Balance</label>
        <input type="text" asp-for="customerBalance" class="form-control" />
        
        <button class="btn btn-primary">Create a new customer</button>
    </div>
</form>