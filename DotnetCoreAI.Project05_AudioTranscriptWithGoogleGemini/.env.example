# Google Gemini API Key
# Google AI Studio uzerinden temin edebilirsiniz: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Kullanilacak Google Gemini Modeli (Varsayilan: gemini-3.6-flash)
# Diger modeller: gemini-flash-latest, gemini-3.5-transcribe
GEMINI_MODEL=gemini-3.6-flash

# (Opsiyonel) Islenecek ses dosyasi yolu (Varsayilan: Arctic Monkeys - Do I Wanna Know_  (Live).mp3)
AUDIO_FILE_PATH=Arctic Monkeys - Do I Wanna Know_  (Live).mp3
